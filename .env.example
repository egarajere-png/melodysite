# Template only — never put real values in this file (it is uploaded to GitHub).
# Copy it to .env.local and fill the values in there. docs/go-live-checklist.md explains where each one comes from.

# --- Database (Supabase → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: full access to the database. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# The site's public address, used for links in emails and WhatsApp messages, e.g. https://your-domain (http://localhost:3000 while testing).
NEXT_PUBLIC_SITE_URL=
# The shop's WhatsApp line for "message us" links: digits only, with country code, e.g. 254712345678.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Email (sent from a Gmail mailbox) ---
# Mail server; for Gmail use smtp.gmail.com
SMTP_HOST=
# Mail server port; for Gmail use 465
SMTP_PORT=
# The Gmail address emails are sent from.
SMTP_USER=
# Secret: that account's 16-letter app password from myaccount.google.com/apppasswords (not the normal password).
SMTP_PASS=
# Name and address customers see, e.g. Aurum Entonet <shop@gmail.com>. Must be the same address as SMTP_USER.
EMAIL_FROM=
# Who receives the "new paid order" alert and contact-form messages. Separate several addresses with commas.
ADMIN_EMAIL=
# Where a customer's reply to an order email goes.
SUPPORT_EMAIL=

# --- WhatsApp (Meta WhatsApp Cloud API) ---
# Secret: permanent system-user token from Meta Business Settings.
WHATSAPP_ACCESS_TOKEN=
# ID of the sending phone number (Meta app → WhatsApp → API Setup).
WHATSAPP_PHONE_NUMBER_ID=
# ID of the WhatsApp Business Account (same page). Used by "npm run setup:whatsapp" to create the message templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Language the templates are created in; use en
WHATSAPP_TEMPLATE_LANGUAGE=
# Who receives the "new paid order" WhatsApp: numbers with country code, separated by commas.
ADMIN_WHATSAPP_NUMBERS=

# --- M-Pesa (Safaricom Daraja, STK Push) ---
# sandbox while testing, production when live.
MPESA_ENVIRONMENT=
# Secret pair from your app on developer.safaricom.co.ke (the live app has its own pair).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox: 174379. Live with a till: the till's store number (head office number), not the till number itself.
MPESA_SHORTCODE=
# Secret. Sandbox: the test passkey on the developer portal. Live: the passkey Safaricom emails after Go Live.
MPESA_PASSKEY=
# Live only: the Buy Goods till number customers pay to. Leave empty in the sandbox.
MPESA_TILL_NUMBER=
# Public https address Safaricom reports payments to: https://your-domain/api/payments/daraja
MPESA_CALLBACK_URL=
# Secret: any long random string (openssl rand -hex 24). It becomes the last part of the callback address.
MPESA_CALLBACK_SECRET=
# Sandbox only: charge this many shillings instead of the order total, e.g. 1. Leave empty when live.
MPESA_SANDBOX_AMOUNT=

# --- Card payments (not built yet) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
